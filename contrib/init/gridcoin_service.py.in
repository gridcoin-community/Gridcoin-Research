"""Set up the Gridcoin core's units, and move a wallet into and out of the service account.

Run as root. Commands:
  enable-user <user>       write the drop-in for <daemon>@<user>.service and start it
  disable-user <user>      stop the unit and remove the drop-ins
  autounlock enable|disable (<user> | --system)
  enable <user>            move the user's wallet into the service account and start <daemon>.service
  disable <user>           move it back to the user and stop <daemon>.service

The per-user core runs with the user's own account, groups and home, as if the user
had started the daemon by hand; enable-user does not touch the user's configuration
file or RPC credentials. enable and disable copy the datadir to fresh files, each side
read or written as its own account, and quarantine the configuration files instead of
carrying them across. Python 3 standard library only.
"""

import argparse
import contextlib
import dataclasses
import datetime
import fcntl
import grp
import json
import os
import posixpath
import pwd
import re
import shutil
import subprocess
import stat
import struct
import sys
import tarfile
import time

CONFIG = {"bindir": "@GRC_BINDIR@", "default_network": "@GRC_UNIT_NETWORK@", "python3": "@GRC_UNIT_PYTHON3@",
          "libexec_subdir_main": "@GRC_LIBEXEC_SUBDIR_MAIN@", "libexec_subdir_test": "@GRC_LIBEXEC_SUBDIR_TEST@",
          "refused_keys_main": "@GRC_REFUSED_KEYS_FILE_MAIN@", "refused_keys_test": "@GRC_REFUSED_KEYS_FILE_TEST@"}

EXIT_USAGE = 64
DROPIN_MAIN = "50-gridcoin-service.conf"
DROPIN_AUTOUNLOCK = "60-gridcoin-autounlock.conf"
# A name made only of dots is refused: "." and ".." name directories. Matched with
# fullmatch and \Z, so a trailing newline is refused too.
USER_RE = re.compile(r"(?!\.+\Z)[A-Za-z0-9._-]+\Z")
UNSAFE_PATH_RE = re.compile(r"[\s\"'\\$%;]")
ROOT_EQUIVALENT_GROUPS = ("docker", "lxd", "incus", "libvirt", "disk", "wheel", "sudo", "adm", "systemd-journal")

# The datadir's top-level entries that are never copied: the running core's lock, socket
# and cookie belong to whichever core runs there.
SKIP_TOP = {".lock", "node.sock", "ipc.cookie"}
# The top-level files that can name commands, files or credentials. They are copied to a
# root-only quarantine, never across; a sanitised gridcoinsettings.json is.
QUARANTINE_TOP = {"gridcoinresearch.conf", "gridcoinsettings.json", "DB_CONFIG"}
CONF_NAME = "gridcoinresearch.conf"
SETTINGS_NAME = "gridcoinsettings.json"
# The core's dated copies of those two files (GetBackupFilename: "<name>-<time>[-<suffix>]"
# in walletbackups/), quarantined like the files themselves. Matched against paths relative
# to the datadir.
BACKUP_DIR = "walletbackups"
CONFIG_BACKUP_RE = re.compile(r"walletbackups/(gridcoinresearch\.conf|gridcoinsettings\.json)-")
# The core's default datadir under the home directory (GetDefaultDataDir on Linux).
DATADIR_NAME = ".GridcoinResearch"
STASH_INFIX = ".in-service-"
TERMINATE_WAIT_SECONDS = 30
# /proc/self/loginuid of a process outside any login session.
UNSET_LOGIN_UID = 4294967295
# The quarantined files are read whole; nothing that size is a real configuration file.
MAX_CONFIG_BYTES = 16 * 1024 * 1024
# The core's MAX_JSON_DEPTH (src/univalue/lib/univalue_read.cpp): it does not load a settings
# file nested deeper.
MAX_JSON_DEPTH = 512
# The grammar build-aux/cmake/refusedkeys2header.cmake enforces on the pattern file.
PATTERN_RE = re.compile(r"[a-z0-9_*-]+\Z")

# Every open below a directory a user or the service account can write uses these: the
# last component is never followed, and a FIFO cannot block the open.
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
FILE_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
NEW_FILE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC


# Fixed search path for every command the tool runs, whatever the caller's PATH.
SAFE_ENV = {"PATH": "/usr/bin:/bin"}


class UserError(Exception):
    pass


class StepError(Exception):
    pass


class TreeError(Exception):
    """A path that may not be copied: not a regular file or a directory, or a name that may not
    be created."""


class CopyError(Exception):
    pass


@dataclasses.dataclass(frozen=True)
class Network:
    daemon: str
    net_arg: str
    account: str
    attach_group: str
    conf_dir: str
    state: str
    autounlock: str
    cred_prefix: str
    subdir: str
    refused_keys: str

    @property
    def tool_name(self):
        return self.account + "-service"

    @property
    def testnet(self):
        return self.net_arg == "-testnet"


# subdir is the helper's directory under libexec, and refused_keys the Refuse class pattern
# file, as CMake installs them.
NETWORKS = {
    "main": Network("gridcoinresearchd", "", "gridcoin", "gridcoin-gui", "/etc/gridcoin",
                    "gridcoinresearchd", "gridcoin-autounlock", "gridcoinresearch", CONFIG["libexec_subdir_main"],
                    CONFIG["refused_keys_main"]),
    "test": Network("gridcointestnetd", "-testnet", "gridcointestnet", "gridcointestnet-gui", "/etc/gridcoin-testnet",
                    "gridcointestnetd", "gridcointestnet-autounlock", "gridcointestnet",
                    CONFIG["libexec_subdir_test"], CONFIG["refused_keys_test"]),
}


@dataclasses.dataclass
class Paths:
    etc_systemd: str = "/etc/systemd/system"
    credstore: str = "/etc/credstore.encrypted"
    var_lib: str = "/var/lib"
    tool_state: str = "/var/lib/gridcoin-service"
    login_defs: str = "/etc/login.defs"


class Host:
    """Real host access. Tests use a fake with the same methods."""

    def systemctl(self, *args):
        return subprocess.call(["systemctl", *args], env=SAFE_ENV)

    def is_enabled(self, unit):
        return subprocess.call(["systemctl", "is-enabled", "--quiet", unit], env=SAFE_ENV) == 0

    def is_active(self, unit):
        return subprocess.call(["systemctl", "is-active", "--quiet", unit], env=SAFE_ENV) == 0

    def getpwnam(self, name):
        return pwd.getpwnam(name)

    def user_groups(self, name):
        pw = pwd.getpwnam(name)
        names = {g.gr_name for g in grp.getgrall() if name in g.gr_mem}
        try:
            names.add(grp.getgrgid(pw.pw_gid).gr_name)
        except KeyError:
            pass
        return sorted(names)

    def is_root(self):
        return os.geteuid() == 0

    def user_processes(self, uid):
        """The pids of the processes with uid as their real, effective, saved or filesystem uid,
        apart from this command's own process tree."""
        table = {}
        for name in os.listdir("/proc"):
            if not name.isdigit():
                continue
            fields = {}
            try:
                with open("/proc/%s/status" % name, "rb") as f:
                    for line in f:
                        key, _, value = line.partition(b":")
                        if key in (b"PPid", b"Uid"):
                            fields[key] = value.split()
                table[int(name)] = (int(fields[b"PPid"][0]), [int(u) for u in fields[b"Uid"]])
            except (OSError, KeyError, IndexError, ValueError):
                # The process ended meanwhile.
                continue
        return foreign_processes(table, uid, os.getpid())

    def login_uid(self):
        try:
            with open("/proc/self/loginuid", encoding="utf8") as f:
                text = f.read()
        except OSError:
            text = ""
        return parse_login_uid(text, os.environ.get("SUDO_UID"))

    def terminate_user(self, name):
        # loginctl reports its own failure (no session, say); the caller then waits for the
        # processes to end and refuses if they do not.
        subprocess.call(["loginctl", "terminate-user", name], env=SAFE_ENV)

    def add_to_group(self, user, group):
        rc = subprocess.call(["gpasswd", "-a", user, group], env=SAFE_ENV, stdout=subprocess.DEVNULL)
        if rc != 0:
            raise StepError("step 'gpasswd -a %s %s' failed with exit status %s" % (user, group, rc))

    def remove_from_group(self, user, group):
        try:
            members = grp.getgrnam(group).gr_mem
        except KeyError:
            return
        if user not in members:
            return
        rc = subprocess.call(["gpasswd", "-d", user, group], env=SAFE_ENV, stdout=subprocess.DEVNULL)
        if rc != 0:
            raise StepError("step 'gpasswd -d %s %s' failed with exit status %s" % (user, group, rc))

    def sleep(self, seconds):
        time.sleep(seconds)

    def monotonic(self):
        return time.monotonic()

    def utcnow(self):
        return datetime.datetime.now(datetime.timezone.utc)

    # The three steps of drop_privileges. Each reads its result back, and a uid change must
    # not be reversible.
    def setgroups(self, groups):
        os.setgroups(groups)
        if sorted(os.getgroups()) != sorted(groups):
            raise StepError("setgroups(%s) did not take effect" % list(groups))

    def setgid(self, gid):
        os.setgid(gid)
        if os.getresgid() != (gid, gid, gid):
            raise StepError("setgid(%d) did not take effect" % gid)

    def setuid(self, uid):
        os.setuid(uid)
        if os.getresuid() != (uid, uid, uid):
            raise StepError("setuid(%d) did not take effect" % uid)
        if uid != 0:
            try:
                os.setuid(0)
            except PermissionError:
                return
            raise StepError("setuid(%d) could be undone; refusing" % uid)


def foreign_processes(table, uid, self_pid):
    """The pids in table ({pid: (ppid, uids)}) that have uid among their uids, leaving out
    self_pid's own tree: itself, its ancestors (sudo keeps the caller's uid as its real uid) and
    its descendants."""
    def chain(pid):
        seen = []
        while pid in table and pid not in seen:
            seen.append(pid)
            pid = table[pid][0]
        return seen

    ancestors = set(chain(self_pid))
    return sorted(pid for pid, (_, uids) in table.items()
                  if uid in uids and pid not in ancestors and self_pid not in chain(pid))


def parse_login_uid(loginuid_text, sudo_uid):
    """The uid whose login this command runs in: /proc/self/loginuid, or SUDO_UID when that is
    unset. None when neither says."""
    text = loginuid_text.strip()
    if text.isdigit() and int(text) != UNSET_LOGIN_UID:
        return int(text)
    if sudo_uid is not None and sudo_uid.isdigit():
        return int(sudo_uid)
    return None


def refuse_own_login(host, pw):
    """A run from the user's own login cannot work: the user's processes include this command's
    own session, and ending the user's sessions would end this command."""
    if host.login_uid() == pw.pw_uid:
        raise UserError("this command runs in %s's own login; run this from another account's login (a root "
                        "console, ssh as root, or another administrator)" % pw.pw_name)


def uid_min(paths):
    try:
        with open(paths.login_defs, encoding="utf8") as f:
            for line in f:
                fields = line.split()
                if len(fields) == 2 and fields[0] == "UID_MIN" and fields[1].isdigit():
                    return int(fields[1])
    except OSError:
        pass
    return 1000


def validate_name(name):
    if not USER_RE.fullmatch(name):
        raise UserError("invalid user name '%s'" % name)


def validate_user(name, host, paths):
    validate_name(name)
    try:
        pw = host.getpwnam(name)
    except KeyError:
        raise UserError("unknown user '%s'" % name) from None
    if pw.pw_uid == 0:
        raise UserError("refusing uid 0")
    if pw.pw_uid < uid_min(paths):
        raise UserError("'%s' is a system account (uid %d below UID_MIN)" % (name, pw.pw_uid))
    return pw


def resolve_datadir(pw, override):
    """Return the validated explicit data directory, or None to use the core's default."""
    if override is None:
        return None
    if not os.path.isabs(override):
        raise UserError("--datadir must be an absolute path")
    if UNSAFE_PATH_RE.search(override):
        raise UserError("--datadir may not contain whitespace, quotes, backslash, $, % or ;")
    path = ""
    for part in override.split("/"):
        if part == "":
            continue
        if part in (".", ".."):
            raise UserError("--datadir may not contain '.' or '..' components")
        path += "/" + part
        if os.path.islink(path):
            raise UserError("--datadir has a symlink component: %s" % path)
    if not os.path.isdir(override):
        raise UserError("--datadir is not an existing directory")
    if os.stat(override).st_uid != pw.pw_uid:
        raise UserError("--datadir is not owned by %s" % pw.pw_name)
    return override


def header(net):
    return "# Written by %s; rerun the tool instead of editing\n" % net.tool_name


def render_user_dropin(net, datadir):
    parts = [os.path.join(CONFIG["bindir"], net.daemon), net.net_arg, "-nodaemon", "-nodaemonwait", "-multiprocess"]
    if datadir is not None:
        parts.append("-datadir=" + datadir)
    parts.append("$GRIDCOIN_AUTOUNLOCK_ARGS")
    # An empty net_arg leaves two spaces, as in the system unit.
    exec_start = " ".join(parts)
    return (header(net) + "[Service]\n"
            "ExecStart=\n"
            "ExecStart=" + exec_start + "\n"
            "Environment=GRIDCOIN_AUTOUNLOCK_ARGS=\n"
            "RestartPreventExitStatus=\n")


def autounlock_target(net, user):
    if user is None:
        return net.daemon + ".service", net.autounlock + ".socket", "/run/%s/%s.sock" % (net.autounlock, net.account)
    return ("%s@%s.service" % (net.daemon, user), "%s@%s.socket" % (net.autounlock, user),
            "/run/%s/%s.sock" % (net.autounlock, user))


def render_autounlock_dropin(net, user):
    _, socket_unit, sock_path = autounlock_target(net, user)
    return (header(net) + "[Unit]\n"
            "Wants=" + socket_unit + "\n"
            "After=" + socket_unit + "\n"
            "[Service]\n"
            "Environment=GRIDCOIN_AUTOUNLOCK_ARGS=-autounlocksocket=" + sock_path + "\n")


def dropin_dir(paths, unit):
    return os.path.join(paths.etc_systemd, unit + ".d")


def owned_by_root(st):
    # A non-root run exists only in tests, where the temporary tree belongs to the caller.
    return st.st_uid in (0, os.geteuid())


def check_dropin_dir(directory):
    """Return whether the drop-in directory exists. One that exists must be a directory owned
    by root, not a symlink, before anything is written into it or removed from it."""
    try:
        st = os.lstat(directory)
    except FileNotFoundError:
        return False
    if not stat.S_ISDIR(st.st_mode) or not owned_by_root(st):
        raise UserError("%s exists but is not a directory owned by root; refusing" % directory)
    return True


def ensure_dropin_dir(directory):
    if not check_dropin_dir(directory):
        os.mkdir(directory, 0o755)


def write_dropin(paths, unit, filename, text):
    directory = dropin_dir(paths, unit)
    ensure_dropin_dir(directory)
    final = os.path.join(directory, filename)
    temp = os.path.join(directory, ".%s.%d.tmp" % (filename, os.getpid()))
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    try:
        with os.fdopen(fd, "w", encoding="utf8") as f:
            f.write(text)
        os.chmod(temp, 0o644)
        if os.geteuid() == 0:
            os.chown(temp, 0, 0)
        os.rename(temp, final)
    except BaseException:
        if os.path.exists(temp):
            os.unlink(temp)
        raise


def remove_dropin(paths, unit, filename):
    directory = dropin_dir(paths, unit)
    if not check_dropin_dir(directory):
        return
    try:
        os.unlink(os.path.join(directory, filename))
    except FileNotFoundError:
        return
    try:
        os.rmdir(directory)
    except OSError:
        pass


def credential_path(paths, net, user):
    """The credential the helper unit loads (LoadCredentialEncrypted=), the only one the tool accepts."""
    if user is not None:
        return os.path.join(paths.credstore, "%s-%s.wallet-passphrase" % (net.cred_prefix, user))
    return os.path.join(paths.credstore, net.cred_prefix + ".wallet-passphrase")


def legacy_credential_path(net):
    """Where the system service's credential was kept before; the helper does not load it."""
    return os.path.join(net.conf_dir, "wallet-passphrase.cred")


def step(host, *args, state="drop-ins already written are kept"):
    rc = host.systemctl(*args)
    if rc != 0:
        raise StepError("step 'systemctl %s' failed with exit status %s; %s" % (" ".join(args), rc, state))


def cmd_enable_user(args, net, host, paths):
    pw = validate_user(args.user, host, paths)
    datadir = resolve_datadir(pw, args.datadir)
    if host.is_enabled(net.daemon + ".service"):
        raise UserError("%s.service is enabled and conflicts with the per-user unit; disable it first" % net.daemon)
    unit = "%s@%s.service" % (net.daemon, args.user)
    write_dropin(paths, unit, DROPIN_MAIN, render_user_dropin(net, datadir))
    step(host, "daemon-reload")
    step(host, "enable", "--now", unit)
    risky = [g for g in host.user_groups(args.user) if g in ROOT_EQUIVALENT_GROUPS]
    if risky:
        print("warning: %s is in groups that are equivalent to root on this machine: %s.\n"
              "The per-user core runs with the user's account and groups; this mode is a convenience\n"
              "(staking, autounlock), not extra isolation. For isolation use `%s enable %s`."
              % (args.user, ", ".join(risky), net.tool_name, args.user))
    return 0


def cmd_disable_user(args, net, host, paths):
    validate_name(args.user)
    unit, socket_unit, _ = autounlock_target(net, args.user)
    # Cleanup continues past a failed disable so the drop-ins of a vanished unit can still go.
    rc = host.systemctl("disable", "--now", unit, socket_unit)
    remove_dropin(paths, unit, DROPIN_MAIN)
    remove_dropin(paths, unit, DROPIN_AUTOUNLOCK)
    step(host, "daemon-reload")
    if rc != 0:
        raise StepError("step 'systemctl disable --now %s %s' failed with exit status %s; the drop-ins were removed"
                        % (unit, socket_unit, rc))
    return 0


def cmd_autounlock(args, net, host, paths):
    user = None if args.system else args.user
    if user is not None:
        if args.action == "enable":
            validate_user(user, host, paths)
        else:
            validate_name(user)
    unit, socket_unit, _ = autounlock_target(net, user)
    if args.action == "enable":
        cred = credential_path(paths, net, user)
        try:
            st = os.stat(cred)
        except OSError:
            legacy = legacy_credential_path(net)
            if user is None and os.path.exists(legacy):
                raise UserError("no credential at %s, the only place the helper loads it from; %s is not used. "
                                "Move it there (owned by root, mode 0600) and run this again" % (cred, legacy)) from None
            raise UserError("no credential at %s; create it first" % cred) from None
        if st.st_uid != 0 or (st.st_mode & 0o777) != 0o600:
            print("warning: %s is not owned by root with mode 0600" % cred)
        write_dropin(paths, unit, DROPIN_AUTOUNLOCK, render_autounlock_dropin(net, user))
        step(host, "daemon-reload")
        step(host, "enable", "--now", socket_unit)
        if host.is_active(unit):
            step(host, "restart", "--no-block", unit)
    else:
        rc = host.systemctl("disable", "--now", socket_unit)
        remove_dropin(paths, unit, DROPIN_AUTOUNLOCK)
        step(host, "daemon-reload")
        if rc != 0:
            raise StepError("step 'systemctl disable --now %s' failed with exit status %s; the drop-in was removed"
                            % (socket_unit, rc))
        if host.is_active(unit):
            step(host, "restart", "--no-block", unit)
        print("The credential file remains until you remove it: %s" % credential_path(paths, net, user))
    return 0


def shown(name):
    """A user-chosen name as printed: as it is when printable, else quoted with escapes."""
    return name if name.isprintable() else repr(name)


def load_refused_patterns(path):
    """Read the Refuse class patterns with the rules build-aux/cmake/refusedkeys2header.cmake
    applies when it compiles the same file into the core: '\\r' removed, blank and '#' lines
    skipped, every other line in the grammar, at least one pattern."""
    try:
        with open(path, encoding="utf8") as f:
            text = f.read()
    except (OSError, UnicodeError) as e:
        raise UserError("cannot read the refused setting key patterns: %s" % e) from None
    patterns = []
    for number, line in enumerate(text.replace("\r", "").split("\n"), start=1):
        if line == "" or line.startswith("#"):
            continue
        if not PATTERN_RE.fullmatch(line):
            raise UserError("%s:%d: line is outside the pattern grammar ^[a-z0-9_*-]+$" % (path, number))
        patterns.append(line)
    if not patterns:
        raise UserError("%s: no patterns" % path)
    return patterns


def match_setting_key_pattern(pattern, name):
    """MatchSettingKeyPattern in src/util/system.cpp, step for step: '*' matches any run of
    characters, every other character itself, against the whole name."""
    p = 0
    n = 0
    # The position of the last '*' in the pattern, and the name position it matched from.
    star = None
    star_name = 0
    while n < len(name):
        if p < len(pattern) and pattern[p] == "*":
            star = p
            p += 1
            star_name = n
        elif p < len(pattern) and pattern[p] == name[n]:
            p += 1
            n += 1
        elif star is not None:
            # Let the last '*' take one more character and retry after it.
            p = star + 1
            star_name += 1
            n = star_name
        else:
            return False
    # Only '*' can remain in the pattern.
    while p < len(pattern) and pattern[p] == "*":
        p += 1
    return p == len(pattern)


def matches_any(name, patterns):
    return any(match_setting_key_pattern(pattern, name) for pattern in patterns)


def is_refused_key(key, patterns):
    """IsRefusedSettingKey in src/util/system.cpp: everything up to the first '.' (a section) is
    dropped, a leading "no" is kept ("noncruncher" is a name of its own)."""
    return matches_any(key[key.find(".") + 1:], patterns)


def refused_as_read(name, patterns):
    """Whether the core refuses name, or the name it reads it as: the section up to the first
    '.' and then a leading "no" removed, as InterpretOption removes them."""
    key = name[name.find(".") + 1:]
    return is_refused_key(name, patterns) or (key.startswith("no") and matches_any(key[2:], patterns))


def json_depth(value):
    """The deepest nesting of objects and arrays in value, the outermost counting 1, as UniValue
    counts it."""
    depth = 0
    pending = [(value, 1)]
    while pending:
        item, level = pending.pop()
        if isinstance(item, dict):
            children = item.values()
        elif isinstance(item, list):
            children = item
        else:
            continue
        depth = max(depth, level)
        pending.extend((child, level + 1) for child in children)
    return depth


def sanitize_settings(text, patterns):
    """Drop from a gridcoinsettings.json text the keys the core refuses. ReadSettingsFile in
    src/util/system.cpp refuses a key when IsRefusedSettingKey holds for it as written, or when
    the key, read through InterpretOption (section and a leading "no" removed), is a
    COMMAND_LINE_ONLY option. The tool has no flags, so for that second arm it tests the patterns,
    which cover every COMMAND_LINE_ONLY option (init_tests.cpp checks it). That also drops the
    "no" form of a refused key that is not COMMAND_LINE_ONLY, which the core would keep and never
    use. Raises ValueError, or RecursionError, where the core's ReadSettings fails (not JSON, not
    an object, a duplicate key, nesting deeper than MAX_JSON_DEPTH) and for a number Python reads
    as infinite, which cannot be written back as JSON. Returns (text, removed keys)."""
    def unique_pairs(pairs):
        obj = {}
        for key, value in pairs:
            if key in obj:
                raise ValueError("duplicate key %s" % shown(key))
            obj[key] = value
        return obj

    def no_constant(name):
        raise ValueError("%s is not JSON" % name)

    settings = json.loads(text, object_pairs_hook=unique_pairs, parse_constant=no_constant)
    if not isinstance(settings, dict):
        raise ValueError("not a JSON object")
    if json_depth(settings) > MAX_JSON_DEPTH:
        raise ValueError("nested deeper than %d levels" % MAX_JSON_DEPTH)
    removed = [key for key in settings if refused_as_read(key, patterns)]
    dropped = set(removed)
    kept = {key: value for key, value in settings.items() if key not in dropped}
    return json.dumps(kept, indent=4, allow_nan=False) + "\n", removed


def sanitize_conf(text, patterns):
    """Drop from a gridcoinresearch.conf text the lines that set a refused key. Lines are read as
    GetConfigOptions in src/util/system.cpp reads them (cut at '#', trimmed, "<section>." put in
    front after a [section] line) and names as InterpretOption reads them (a section up to the
    first '.', then a leading "no" negates): a line goes when the name as written or the name it
    negates is refused. A line the core rejects (no '=', or a leading '-') goes too, reported by
    its number only, as it may hold a secret. Returns (text, removed keys)."""
    kept = []
    removed = []
    prefix = ""
    for number, line in enumerate(text.split("\n"), start=1):
        body = line.split("#", 1)[0].strip(" \t\r\n")
        if body == "":
            kept.append(line)
        elif body.startswith("[") and body.endswith("]"):
            prefix = body[1:-1] + "."
            kept.append(line)
        elif body.startswith("-") or "=" not in body:
            removed.append("line %d (not a setting)" % number)
        else:
            name = prefix + body.split("=", 1)[0].strip(" \t\r\n")
            if refused_as_read(name, patterns):
                removed.append(name)
            else:
                kept.append(line)
    return "\n".join(kept), removed


def interpret_bool(value):
    """InterpretBool in src/util/system.cpp: empty is true; otherwise the value as ParseInt32 reads
    it (an optional sign and digits, within int32; 0 when it does not parse) is true when not 0."""
    if value == "":
        return True
    if re.fullmatch(r"[+-]?[0-9]+", value) and -2 ** 31 <= int(value) < 2 ** 31:
        return int(value) != 0
    return False


def conf_selects_testnet(text):
    """Whether a conf selects testnet in its top level, before any [section] line, as the core reads
    it: lines as GetConfigOptions reads them, testnet=<v> as InterpretBool(v) and notestnet=<v> as
    its negation (InterpretOption), the last such line winning."""
    selected = False
    for line in text.split("\n"):
        body = line.split("#", 1)[0].strip(" \t\r\n")
        if body.startswith("[") and body.endswith("]"):
            break
        if "=" not in body:
            continue
        name, value = (part.strip(" \t\r\n") for part in body.split("=", 1))
        if name == "testnet":
            selected = interpret_bool(value)
        elif name == "notestnet":
            selected = not interpret_bool(value)
    return selected


def open_dir(name, dir_fd=None, uids=None, display=None):
    """Open a directory without following a symlink in its last component, and check with fstat
    that it is a directory owned by one of uids (any owner when None). FileNotFoundError passes
    through for the caller to word."""
    display = name if display is None else display
    try:
        fd = os.open(name, DIR_FLAGS, dir_fd=dir_fd)
    except FileNotFoundError:
        raise
    except OSError as e:
        raise UserError("%s: %s (a symlink is not followed); refusing" % (display, e.strerror)) from None
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        os.close(fd)
        raise UserError("%s is not a directory; refusing" % display)
    if uids is not None and st.st_uid not in uids:
        os.close(fd)
        raise UserError("%s is owned by uid %d, not %s; refusing"
                        % (display, st.st_uid, " or ".join(str(uid) for uid in uids)))
    return fd


def create_dir(name, dir_fd, display, owner=None):
    """Create the directory name in dir_fd, 0700, for owner (a passwd entry; this process when
    None). It must not exist yet, and what is then opened must be the new, empty directory: one
    swapped in meanwhile is refused before any fchown or use."""
    try:
        os.mkdir(name, 0o700, dir_fd=dir_fd)
    except FileExistsError:
        raise UserError("%s exists already; refusing" % display) from None
    fd = open_dir(name, dir_fd=dir_fd, uids=(os.geteuid(),), display=display)
    st = os.fstat(fd)
    # A new directory has two links, or one on filesystems that do not count a directory's
    # links (btrfs), and no entries.
    if st.st_nlink > 2 or os.listdir(fd):
        os.close(fd)
        raise UserError("%s was replaced while it was created; refusing" % display)
    if owner is not None and os.geteuid() == 0:
        os.fchown(fd, owner.pw_uid, owner.pw_gid)
    os.fchmod(fd, 0o700)
    return fd


def make_dir(name, dir_fd, display, owner=None, existing_uids=None):
    """Open the directory name in dir_fd, or create it with create_dir when it is missing. One
    that exists must be owned by one of existing_uids (owner's uid when None)."""
    uid = os.geteuid() if owner is None else owner.pw_uid
    try:
        return open_dir(name, dir_fd=dir_fd, uids=existing_uids or (uid,), display=display)
    except FileNotFoundError:
        return create_dir(name, dir_fd, display, owner)


def open_entry(dir_fd, name, display, dev=None):
    """Open name in dir_fd when it is a directory or a regular file, on the filesystem dev when
    given. It is checked with lstat first, so nothing else is ever opened (a FIFO would block, a
    device could act, a mount is not walked), then opened without following a symlink and checked
    with fstat to be the same inode. Returns (fd, stat)."""
    try:
        st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
    except OSError as e:
        raise TreeError("%r: %s" % (display, e.strerror)) from None
    if dev is not None and st.st_dev != dev:
        raise TreeError("%r is on another filesystem (a mount point); refusing" % display)
    if stat.S_ISDIR(st.st_mode):
        flags = DIR_FLAGS
    elif stat.S_ISREG(st.st_mode):
        flags = FILE_FLAGS
    else:
        raise TreeError("%r is not a regular file or a directory" % display)
    try:
        fd = os.open(name, flags, dir_fd=dir_fd)
    except OSError as e:
        raise TreeError("%r: %s" % (display, e.strerror)) from None
    fst = os.fstat(fd)
    if (fst.st_dev, fst.st_ino, stat.S_IFMT(fst.st_mode)) != (st.st_dev, st.st_ino, stat.S_IFMT(st.st_mode)):
        os.close(fd)
        raise TreeError("%r changed while it was read" % display)
    return fd, fst


def stream_dir(tar, dir_fd, prefix, exclude_top, dev):
    for name in sorted(os.listdir(dir_fd)):
        if not prefix and name in exclude_top:
            continue
        rel = prefix + name
        if CONFIG_BACKUP_RE.match(rel):
            continue
        fd, st = open_entry(dir_fd, name, rel, dev)
        try:
            info = tarfile.TarInfo(rel)
            info.mtime = int(st.st_mtime)
            if stat.S_ISDIR(st.st_mode):
                info.type = tarfile.DIRTYPE
                info.mode = 0o700
                tar.addfile(info)
                stream_dir(tar, fd, rel + "/", exclude_top, dev)
            else:
                # A member built here, not by gettarinfo, so a hard link is sent as a file of its own.
                info.mode = 0o600
                info.size = st.st_size
                with os.fdopen(fd, "rb", closefd=False) as f:
                    tar.addfile(info, f)
        finally:
            os.close(fd)


def stream_tree(src_dir, out, exclude_top):
    """Write the directories and regular files below src_dir (a path, or an open directory fd) to
    out as a tar stream, leaving out the top-level names in exclude_top and the core's backups of
    its conf and settings in walletbackups/ (quarantine_files takes those). Each entry is opened
    without following a symlink and checked with fstat; anything else, at any depth, raises
    TreeError naming its path relative to src_dir, as does an entry on another filesystem."""
    top = open_dir(src_dir) if isinstance(src_dir, str) else src_dir
    try:
        with tarfile.open(fileobj=out, mode="w|", format=tarfile.PAX_FORMAT) as tar:
            stream_dir(tar, top, "", exclude_top, os.fstat(top).st_dev)
    finally:
        if isinstance(src_dir, str):
            os.close(top)


def check_member(member):
    """Return (parent, base) of a member extract_stream may create, or raise TreeError."""
    name = member.name
    if not (member.isdir() or member.isfile()):
        raise TreeError("%r: only directories and regular files are copied" % name)
    if "\0" in name or any(part in ("", ".", "..") for part in name.split("/")) or posixpath.normpath(name) != name:
        raise TreeError("%r: not a plain relative name" % name)
    return posixpath.split(name)


def extract_stream(inp, dst_dir, created=None):
    """Create below dst_dir (a path, or an open directory fd) the directories and regular files of
    the tar stream inp, as new inodes: files 0600 and directories 0700, each created exclusively
    and without following a symlink, inside a directory the same stream created. A member of any
    other type, or with an absolute or unnormalised name, raises TreeError. Each top-level name is
    appended to created (a list) once it exists, so the names are known after a failure too.
    Returns the number of file bytes written."""
    top = open_dir(dst_dir) if isinstance(dst_dir, str) else dst_dir
    dirs = {"": top}
    written = 0
    try:
        with tarfile.open(fileobj=inp, mode="r|") as tar:
            for member in tar:
                parent, base = check_member(member)
                parent_fd = dirs.get(parent)
                if parent_fd is None:
                    raise TreeError("%r: its directory is not earlier in the stream" % member.name)
                if member.isdir():
                    os.mkdir(base, 0o700, dir_fd=parent_fd)
                    if not parent and created is not None:
                        created.append(base)
                    dirs[member.name] = open_dir(base, dir_fd=parent_fd, display=member.name)
                    continue
                fd = os.open(base, NEW_FILE_FLAGS, 0o600, dir_fd=parent_fd)
                if not parent and created is not None:
                    created.append(base)
                with os.fdopen(fd, "wb") as f:
                    data = tar.extractfile(member)
                    while True:
                        chunk = data.read(1 << 20)
                        if not chunk:
                            break
                        f.write(chunk)
                        written += len(chunk)
        # Read to the end, so the writing side never blocks on its padding; only zeros may follow.
        while True:
            chunk = inp.read(1 << 16)
            if not chunk:
                break
            if chunk.count(0) != len(chunk):
                raise TreeError("data after the end of the archive")
    finally:
        for name, fd in dirs.items():
            if name:
                os.close(fd)
        if isinstance(dst_dir, str):
            os.close(top)
    return written


def drop_privileges(host, pw):
    """Become pw: no supplementary groups, then its group, then its user. The order matters, as
    the groups can no longer change once the uid has. The host checks each step. A copy never
    runs as uid or gid 0."""
    if pw.pw_uid == 0 or pw.pw_gid == 0:
        raise StepError("refusing to run as %s (uid %d, gid %d)" % (shown(pw.pw_name), pw.pw_uid, pw.pw_gid))
    host.setgroups([])
    host.setgid(pw.pw_gid)
    host.setuid(pw.pw_uid)


def close_inherited_fds(keep):
    """Close every descriptor above stderr except those in keep (in a fork child)."""
    for name in os.listdir("/proc/self/fd"):
        fd = int(name)
        if fd > 2 and fd not in keep:
            try:
                os.close(fd)
            except OSError:
                # The descriptor of the listing itself, closed already.
                pass


def start_child(host, pw, body, keep):
    """Fork a child that keeps only the descriptors in keep, becomes pw when this process is
    root, runs body() and reports its result or its exception. Returns (pid, report fd)."""
    report_r, report_w = os.pipe()
    pid = os.fork()
    if pid == 0:
        code = 70
        try:
            try:
                close_inherited_fds(set(keep) | {report_w})
                if os.geteuid() == 0:
                    drop_privileges(host, pw)
                os.umask(0o077)
                report = {"ok": True, "value": body()}
                code = 0
            except BaseException as e:
                report = {"ok": False, "error": type(e).__name__, "message": str(e)}
            data = json.dumps(report).encode("ascii")
            while data:
                data = data[os.write(report_w, data):]
        finally:
            os._exit(code)
    os.close(report_w)
    return pid, report_r


def finish_child(pid, report_fd):
    """Wait for a start_child child and return its report; a child that left none failed."""
    with os.fdopen(report_fd, "rb") as f:
        data = f.read()
    _, status = os.waitpid(pid, 0)
    try:
        report = json.loads(data.decode("ascii"))
    except ValueError:
        report = None
    if not isinstance(report, dict) or (report.get("ok") and status != 0):
        return {"ok": False, "error": "ChildError", "message": "a child process ended with wait status %d" % status}
    return report


def child_error(report):
    if report["error"] == "TreeError":
        return TreeError(report["message"])
    return CopyError("%s: %s" % (report["error"], report["message"]))


def run_as(host, pw, body, keep):
    report = finish_child(*start_child(host, pw, body, keep))
    if not report["ok"]:
        raise child_error(report)
    return report["value"]


def remove_entries(dir_fd, names):
    """Remove the named entries of dir_fd, directories with all they hold. Only ever runs in a
    child: it changes the working directory, so that shutil.rmtree works relative to dir_fd on any
    Python 3 (its dir_fd argument needs 3.11), and relies on rmtree's symlink-safe
    implementation."""
    if not shutil.rmtree.avoids_symlink_attacks:
        raise CopyError("shutil.rmtree can follow symlinks on this platform; nothing was removed")
    os.fchdir(dir_fd)
    for name in names:
        try:
            st = os.lstat(name)
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(st.st_mode):
            shutil.rmtree(name)
        else:
            os.unlink(name)


def empty_dir(dir_fd, keep):
    """Remove every entry of dir_fd not named in keep (in a child, as remove_entries)."""
    remove_entries(dir_fd, [name for name in os.listdir(dir_fd) if name not in keep])


class CreatedNames(list):
    """The top-level names a writer created. Each is also written, as it comes, to record_fd (one
    JSON string per line), so the parent knows them should the writer die without a report."""

    def __init__(self, record_fd):
        super().__init__()
        self.record_fd = record_fd

    def append(self, name):
        super().append(name)
        data = (json.dumps(name) + "\n").encode("ascii")
        while data:
            data = data[os.write(self.record_fd, data):]


def recorded_names(record_fd):
    """The names a dead writer recorded; a line cut short by its death is skipped."""
    data = os.pread(record_fd, os.fstat(record_fd).st_size, 0)
    names = []
    for line in data.split(b"\n"):
        try:
            name = json.loads(line.decode("ascii"))
        except ValueError:
            continue
        if isinstance(name, str):
            names.append(name)
    return names


def stream_to_fd(src_fd, data_fd, exclude_top):
    with os.fdopen(data_fd, "wb") as out:
        stream_tree(src_fd, out, exclude_top)


def extract_committed(data_fd, dst_fd, commit_fd, record_fd):
    """The writer child: extract, then keep the result only once the parent confirms the reader
    finished cleanly. Otherwise remove what this run created, and nothing else."""
    created = CreatedNames(record_fd)
    try:
        with os.fdopen(data_fd, "rb") as inp:
            written = extract_stream(inp, dst_fd, created)
        committed = os.read(commit_fd, 1) == b"c"
    except BaseException:
        remove_entries(dst_fd, created)
        raise
    if not committed:
        remove_entries(dst_fd, created)
        raise CopyError("the reading side did not finish; nothing was kept")
    return written


def copy_as(src, dst, src_user, dst_user, exclude_top, host):
    """Copy the tree src into the directory dst (each a path or an open directory fd) as fresh
    files. A reader child streams src as src_user and a writer child extracts into dst as dst_user,
    with a pipe between them; each takes on its user only when this process is root. The writer
    keeps what it wrote only once the reader has finished cleanly, and otherwise removes every
    entry it added. Should the writer die without a report, a cleanup child, as dst_user, removes
    the entries it recorded. A failure of either side raises TreeError or CopyError."""
    src_pw = host.getpwnam(src_user)
    dst_pw = host.getpwnam(dst_user)
    with contextlib.ExitStack() as stack:
        if isinstance(src, str):
            src = open_dir(src)
            stack.callback(os.close, src)
        if isinstance(dst, str):
            dst = open_dir(dst)
            stack.callback(os.close, dst)
        data_r, data_w = os.pipe()
        commit_r, commit_w = os.pipe()
        record_fd = os.memfd_create("gridcoin-service-created", os.MFD_CLOEXEC)
        stack.callback(os.close, record_fd)
        pending = [data_r, data_w, commit_r, commit_w]
        try:
            reader = start_child(host, src_pw, lambda: stream_to_fd(src, data_w, exclude_top), (src, data_w))
            writer = start_child(host, dst_pw, lambda: extract_committed(data_r, dst, commit_r, record_fd),
                                 (dst, data_r, commit_r, record_fd))
            for fd in (data_r, data_w, commit_r):
                pending.remove(fd)
                os.close(fd)
            reader_report = finish_child(*reader)
            if reader_report["ok"]:
                try:
                    os.write(commit_w, b"c")
                except BrokenPipeError:
                    # The writer has failed already; its report says why.
                    pass
            pending.remove(commit_w)
            os.close(commit_w)
            writer_report = finish_child(*writer)
            if writer_report.get("error") == "ChildError":
                # The writer died without a report, so it removed nothing: remove what it recorded.
                names = recorded_names(record_fd)
                cleanup = finish_child(*start_child(host, dst_pw, lambda: remove_entries(dst, names), (dst,)))
                if cleanup["ok"]:
                    outcome = "the %d entries it had created were removed" % len(names)
                else:
                    outcome = "removing the %d entries it had created failed (%s)" % (len(names), cleanup["message"])
                writer_report = {"ok": False, "error": "CopyError",
                                 "message": "the writing side ended without a report (%s); %s"
                                            % (writer_report["message"], outcome)}
        finally:
            for fd in pending:
                os.close(fd)
    if not reader_report["ok"]:
        # A reader cut off by a failed writer reports a broken pipe; the writer's error is the cause.
        if reader_report["error"] == "BrokenPipeError" and not writer_report["ok"]:
            raise child_error(writer_report)
        raise child_error(reader_report)
    if not writer_report["ok"]:
        raise child_error(writer_report)


def write_file_as(dir_fd, name, data, pw, host):
    """Create name in dir_fd as pw (when root): 0600, exclusively, without following a symlink."""
    def body():
        with os.fdopen(os.open(name, NEW_FILE_FLAGS, 0o600, dir_fd=dir_fd), "wb") as f:
            f.write(data)

    run_as(host, pw, body, (dir_fd,))


def write_new_file(dir_fd, name, data):
    with os.fdopen(os.open(name, NEW_FILE_FLAGS, 0o600, dir_fd=dir_fd), "wb") as f:
        f.write(data)


def hold_datadir_lock(path, owner_uid):
    """Take the core's lock on the datadir path (a path, or an open directory fd): a write lock on
    its .lock, opened read-write without following a symlink and never created, which must be a
    regular file with one link, owned by owner_uid (the side's own account). Returns the
    descriptor that holds the lock until it is closed, or None when there is no .lock. Raises
    UserError when another process holds the lock."""
    flags = os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        if isinstance(path, int):
            fd = os.open(".lock", flags, dir_fd=path)
        else:
            fd = os.open(os.path.join(path, ".lock"), flags)
    except FileNotFoundError:
        return None
    except OSError as e:
        raise UserError("cannot open the datadir lock .lock: %s (a symlink is not followed)" % e.strerror) from None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise UserError("the datadir lock .lock is not a regular file; refusing")
        if st.st_uid != owner_uid:
            raise UserError("the datadir lock .lock is owned by uid %d, not %d; refusing" % (st.st_uid, owner_uid))
        if st.st_nlink != 1:
            raise UserError("the datadir lock .lock has %d links; refusing" % st.st_nlink)
        # An open file description lock, so that closing some other descriptor of the file in this
        # process does not release it, as it would a traditional fcntl lock. Linux makes the two
        # kinds conflict, so it excludes the core's F_SETLK in FileLock::TryLock, and the reverse.
        # struct flock: l_type, l_whence, l_start, l_len, l_pid (0 for this kind of lock).
        request = struct.pack("hhqqi", fcntl.F_WRLCK, os.SEEK_SET, 0, 0, 0)
        try:
            fcntl.fcntl(fd, fcntl.F_OFD_SETLK, request)
        except (BlockingIOError, PermissionError):
            raise UserError("the datadir is in use: another process holds its .lock; stop it first") from None
    except BaseException:
        os.close(fd)
        raise
    return fd


def stamp(host):
    return host.utcnow().strftime("%Y%m%dT%H%M%SZ")


def is_testnet_entry(name):
    """The testnet datadir and its stashes, which live inside the mainnet datadir."""
    return name == "testnet" or name.startswith("testnet" + STASH_INFIX)


def stash_source(parent_fd, name, src_fd, stash_name, keep, display, copies=None):
    """Move the entries of src_fd (the directory name in parent_fd), except those in keep, into a
    new directory stash_name in parent_fd, root's and 0700, write copies ({name: bytes}) there as
    root's files, and remove src once it is empty. All of it goes through parent_fd, which was
    opened without following a symlink."""
    stash_fd = create_dir(stash_name, parent_fd, display)
    try:
        # root:root, whatever group a setgid parent would hand down.
        if os.geteuid() == 0:
            os.fchown(stash_fd, 0, 0)
        for entry in sorted(os.listdir(src_fd)):
            if entry not in keep:
                os.rename(entry, entry, src_dir_fd=src_fd, dst_dir_fd=stash_fd)
        for entry, data in (copies or {}).items():
            write_new_file(stash_fd, entry, data)
    finally:
        os.close(stash_fd)
    if not os.listdir(src_fd):
        # Only the directory that was emptied, should the name have been replaced meanwhile.
        if os.path.samestat(os.stat(name, dir_fd=parent_fd, follow_symlinks=False), os.fstat(src_fd)):
            os.rmdir(name, dir_fd=parent_fd)


def open_tool_state(paths):
    """The tool's own state directory, root's (/var/lib/gridcoin-service, from tmpfiles.d)."""
    os.makedirs(paths.tool_state, 0o700, exist_ok=True)
    return open_dir(paths.tool_state, uids=(os.geteuid(),))


def owner_record_path(paths, network):
    return os.path.join(paths.tool_state, network + ".owner")


def read_owner_record(state_fd, paths, network):
    """The record enable left for this network: {"uid", "user", "stash"}, or None when there is
    none. One that is not root's own 0600 regular file, or not in that form, is refused."""
    name = network + ".owner"
    display = owner_record_path(paths, network)
    if name not in os.listdir(state_fd):
        return None
    fd, st = open_entry(state_fd, name, display)
    try:
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o077:
            raise UserError("%s is not a record this tool wrote (root's own, mode 0600); refusing" % display)
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read(MAX_CONFIG_BYTES + 1)
    finally:
        os.close(fd)
    try:
        record = json.loads(data.decode("utf8"))
    except ValueError:
        record = None
    if (not isinstance(record, dict) or not isinstance(record.get("uid"), int)
            or not isinstance(record.get("user"), str) or not isinstance(record.get("stash"), str)):
        raise UserError("%s is not a record this tool wrote; refusing" % display)
    return record


def write_owner_record(state_fd, network, pw, stash_display):
    """Record, root-only, whose wallet enable moved into this network's service and where the
    source went, so that only disable for that user takes it out again."""
    record = {"uid": pw.pw_uid, "user": pw.pw_name, "stash": stash_display}
    write_new_file(state_fd, network + ".owner", (json.dumps(record) + "\n").encode("utf8"))


def open_quarantine(state_fd, paths, user, network, host):
    """Create <tool_state>/quarantine/<user>-<network>-<UTC time>/, root's and 0700. Returns
    (fd, path)."""
    root_fd = make_dir("quarantine", state_fd, os.path.join(paths.tool_state, "quarantine"))
    try:
        name = "%s-%s-%s" % (user, network, stamp(host))
        display = os.path.join(paths.tool_state, "quarantine", name)
        fd = create_dir(name, root_fd, display)
    finally:
        os.close(root_fd)
    return fd, display


def read_owned_file(dir_fd, name, owner_uids, display):
    """Read name in dir_fd as root. It must be a regular file owned by one of owner_uids, so root
    reads nothing those owners could not (a hard link to another account's file is refused), and
    on dir_fd's filesystem."""
    fd, st = open_entry(dir_fd, name, display, os.fstat(dir_fd).st_dev)
    try:
        if not stat.S_ISREG(st.st_mode) or st.st_uid not in owner_uids:
            raise TreeError("%r is not a regular file owned by uid %s; refusing"
                            % (display, " or ".join(str(uid) for uid in owner_uids)))
        with os.fdopen(fd, "rb", closefd=False) as f:
            data = f.read(MAX_CONFIG_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > MAX_CONFIG_BYTES:
        raise TreeError("%r is larger than %d bytes; refusing" % (display, MAX_CONFIG_BYTES))
    return data


def quarantine_files(src_fd, src_display, owner_uid, q_fd):
    """Copy the QUARANTINE_TOP files of src_fd, and the core's backups of them in walletbackups/,
    into q_fd. Returns the top-level files' contents by name, and the backups' paths."""
    found = {}
    for name in sorted(QUARANTINE_TOP & set(os.listdir(src_fd))):
        found[name] = read_owned_file(src_fd, name, (owner_uid,), os.path.join(src_display, name))
        write_new_file(q_fd, name, found[name])
    backups = []
    if BACKUP_DIR not in os.listdir(src_fd):
        return found, backups
    dir_display = os.path.join(src_display, BACKUP_DIR)
    backup_fd = open_dir(BACKUP_DIR, dir_fd=src_fd, uids=(owner_uid,), display=dir_display)
    q_backup_fd = None
    try:
        for name in sorted(os.listdir(backup_fd)):
            rel = BACKUP_DIR + "/" + name
            if not CONFIG_BACKUP_RE.match(rel):
                continue
            data = read_owned_file(backup_fd, name, (owner_uid,), os.path.join(dir_display, name))
            if q_backup_fd is None:
                q_backup_fd = create_dir(BACKUP_DIR, q_fd, BACKUP_DIR)
            write_new_file(q_backup_fd, name, data)
            backups.append(rel)
    finally:
        os.close(backup_fd)
        if q_backup_fd is not None:
            os.close(q_backup_fd)
    return found, backups


def sanitize_quarantined(found, patterns, q_fd, src_display):
    """Sanitise what quarantine_files found, before anything is copied: a settings file the core
    would not load refuses the command. The sanitised conf goes next to the quarantined one, for
    root's review. Returns (sanitised settings text or None, report lines naming keys only)."""
    lines = []
    settings_text = None
    if SETTINGS_NAME in found:
        display = os.path.join(src_display, SETTINGS_NAME)
        try:
            settings_text, removed = sanitize_settings(found[SETTINGS_NAME].decode("utf8"), patterns)
        except UnicodeDecodeError:
            # Its message would quote a byte of the file.
            raise UserError("%s is not UTF-8, so the core cannot load it; fix or remove it, then rerun"
                            % display) from None
        except (ValueError, RecursionError) as e:
            raise UserError("%s cannot be loaded as the core loads it (%s); fix or remove it, then rerun"
                            % (display, e)) from None
        if removed:
            lines.append("Removed from %s: %s" % (SETTINGS_NAME, ", ".join(shown(k) for k in removed)))
        carried = list(json.loads(settings_text))
        if carried:
            # The tool cannot see the core's flags, so it names every carried key; the ones that
            # need elevation (proxy, connect, addnode and the like) are among them.
            lines.append("Carried over in %s, for review: %s" % (SETTINGS_NAME, ", ".join(shown(k) for k in carried)))
    if CONF_NAME in found:
        text, removed = sanitize_conf(found[CONF_NAME].decode("utf8", "surrogateescape"), patterns)
        write_new_file(q_fd, CONF_NAME + ".sanitized", text.encode("utf8", "surrogateescape"))
        if removed:
            lines.append("Left out of %s.sanitized: %s" % (CONF_NAME, ", ".join(shown(k) for k in removed)))
    return settings_text, lines


def report_quarantine(found, backups, q_display, lines):
    names = sorted(found)
    if backups:
        names.append("%d of their backups from %s/" % (len(backups), BACKUP_DIR))
    if names:
        print("Quarantined %s in %s (root only); review before using any of it." % (", ".join(names), q_display))
    for line in lines:
        print(line)


def service_account(net, host, paths):
    """The network's service account, which must be a system account: not uid 0, and below
    UID_MIN (login.defs, or 1000)."""
    try:
        acct = host.getpwnam(net.account)
    except KeyError:
        raise UserError("the service account %s does not exist; is the package installed?" % net.account) from None
    limit = uid_min(paths)
    if acct.pw_uid == 0 or acct.pw_uid >= limit:
        raise UserError("the service account %s has uid %d; it must be a system account (uid 1 to %d)"
                        % (net.account, acct.pw_uid, limit - 1))
    return acct


def open_home(pw):
    """The user's home directory from the passwd entry, opened without following a symlink."""
    try:
        return open_dir(pw.pw_dir, uids=(pw.pw_uid,), display="home directory " + pw.pw_dir)
    except FileNotFoundError:
        raise UserError("home directory %s does not exist" % pw.pw_dir) from None


def open_user_dir(dir_fd, name, pw, display):
    try:
        return open_dir(name, dir_fd=dir_fd, uids=(pw.pw_uid,), display=display)
    except FileNotFoundError:
        raise UserError("%s does not exist" % display) from None


def service_dir_display(paths, net):
    return os.path.join(paths.var_lib, net.state, *(["testnet"] if net.testnet else []))


def open_service_dir(paths, net, acct, create):
    """Open the service datadir, /var/lib/<state> (testnet: its testnet/), owned by the account
    or root; with create, make what is missing for the account. FileNotFoundError when it is
    missing otherwise. /var/lib is root's; below it nothing is followed. Returns (fd, path)."""
    path = paths.var_lib
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in [net.state] + (["testnet"] if net.testnet else []):
            path = os.path.join(path, part)
            if create:
                next_fd = make_dir(part, fd, path, owner=acct, existing_uids=(acct.pw_uid, 0))
            else:
                next_fd = open_dir(part, dir_fd=fd, uids=(acct.pw_uid, 0), display=path)
            os.close(fd)
            fd = next_fd
    except BaseException:
        os.close(fd)
        raise
    return fd, path


def end_user_processes(host, pw, terminate):
    """Refuse while the user has processes; with terminate, end the user's sessions and wait up to
    TERMINATE_WAIT_SECONDS for the processes to go."""
    def listed(pids):
        return ", ".join(str(pid) for pid in pids[:5]) + (", ..." if len(pids) > 5 else "")

    pids = host.user_processes(pw.pw_uid)
    if not pids:
        return
    if not terminate:
        raise UserError("%s has running processes (%s); have them log out, or rerun with --terminate-sessions"
                        % (pw.pw_name, listed(pids)))
    host.terminate_user(pw.pw_name)
    deadline = host.monotonic() + TERMINATE_WAIT_SECONDS
    while True:
        pids = host.user_processes(pw.pw_uid)
        if not pids:
            return
        if host.monotonic() >= deadline:
            raise UserError("%s still has running processes (%s) %d s after their sessions were ended; refusing"
                            % (pw.pw_name, listed(pids), TERMINATE_WAIT_SECONDS))
        host.sleep(1)


def refuse_other_network_core(host, network, user):
    """Both networks' per-user cores use the same datadir root and conf, so the other network's
    must not run during a switch. The tool never stops it itself."""
    other = NETWORKS["test" if network == "main" else "main"]
    unit = "%s@%s.service" % (other.daemon, user)
    if host.is_active(unit):
        raise UserError("%s is running and shares %s's datadir and conf; stop it first with: systemctl stop %s"
                        % (unit, user, unit))


def refuse_user_unit_datadir(paths, net, user, d_display):
    """enable moves only the default datadir, so the per-user unit must not have one of its own."""
    unit = "%s@%s.service" % (net.daemon, user)
    directory = dropin_dir(paths, unit)
    if not check_dropin_dir(directory):
        return
    path = os.path.join(directory, DROPIN_MAIN)
    try:
        with open(path, encoding="utf8") as f:
            text = f.read()
    except FileNotFoundError:
        return
    if re.search(r"(?m)^ExecStart=.*\s-datadir=", text):
        raise UserError("%s gives %s a -datadir of its own, but enable moves only %s; move that wallet there "
                        "first, then rerun enable-user without --datadir" % (path, unit, d_display))


@contextlib.contextmanager
def stage(state):
    """Add to a failure inside the block the state the command leaves behind, as step() does for
    systemctl."""
    try:
        yield
    except (UserError, StepError, TreeError, CopyError, OSError) as e:
        raise StepError("%s; %s" % (e, state)) from None


def take_lock(fd, display, owner_uid):
    try:
        return hold_datadir_lock(fd, owner_uid)
    except UserError as e:
        raise UserError("%s: %s" % (display, e)) from None


def copy_tree(src_fd, dst_fd, src_user, dst_user, exclude, host, src_display):
    try:
        copy_as(src_fd, dst_fd, src_user, dst_user, exclude, host)
    except TreeError as e:
        raise TreeError("in %s: %s" % (src_display, e)) from None


def cmd_enable(args, net, host, paths):
    pw = validate_user(args.user, host, paths)
    refuse_own_login(host, pw)
    acct = service_account(net, host, paths)
    patterns = load_refused_patterns(net.refused_keys)
    with contextlib.ExitStack() as stack:
        def keep(fd):
            stack.callback(os.close, fd)
            return fd

        # 1. The source S (the user's datadir; testnet: its testnet/) and the target T, the
        # service datadir, which must be empty. Nothing is changed before this passes.
        home_fd = keep(open_home(pw))
        d_display = os.path.join(pw.pw_dir, DATADIR_NAME)
        d_fd = keep(open_user_dir(home_fd, DATADIR_NAME, pw, d_display))
        if net.testnet:
            s_parent_fd, s_name, s_display = d_fd, "testnet", os.path.join(d_display, "testnet")
            s_fd = keep(open_user_dir(d_fd, s_name, pw, s_display))
        else:
            s_parent_fd, s_name, s_display, s_fd = home_fd, DATADIR_NAME, d_display, d_fd
        # The stash is a rename next to S, which cannot cross a mount point.
        if os.fstat(s_fd).st_dev != os.fstat(s_parent_fd).st_dev:
            raise UserError("%s is a mount point; move its contents to a plain directory first" % s_display)
        state_fd = keep(open_tool_state(paths))
        record = read_owner_record(state_fd, paths, args.network)
        if record is not None:
            raise UserError("%s records a wallet moved into the service for %s; run disable for that user first, "
                            "or remove the record if the service datadir holds no wallet"
                            % (owner_record_path(paths, args.network), shown(record["user"])))
        try:
            t_check_fd, t_display = open_service_dir(paths, net, acct, create=False)
        except FileNotFoundError:
            pass
        else:
            keep(t_check_fd)
            if os.listdir(t_check_fd):
                raise UserError("%s exists and is not empty; refusing" % t_display)
        refuse_user_unit_datadir(paths, net, pw.pw_name, d_display)
        names = os.listdir(d_fd)
        testnet_entries = set() if net.testnet else {n for n in names if is_testnet_entry(n)}
        # The conf at the datadir root is read by both networks: beside testnet's datadir it stays.
        shared_conf = bool(testnet_entries) and CONF_NAME in names
        if not net.testnet and CONF_NAME in names:
            conf_display = os.path.join(d_display, CONF_NAME)
            conf = read_owned_file(d_fd, CONF_NAME, (pw.pw_uid,), conf_display)
            if conf_selects_testnet(conf.decode("utf8", "surrogateescape")):
                raise UserError("%s sets testnet=1, so this user's node runs testnet; use --network=test"
                                % conf_display)
        refuse_other_network_core(host, args.network, pw.pw_name)

        # 2. Stop both cores that could use either datadir. From here on every failure says what
        # it left behind.
        unit, socket_unit, _ = autounlock_target(net, pw.pw_name)
        step(host, "disable", "--now", unit, socket_unit, state="nothing was copied")
        step(host, "stop", net.daemon + ".service", state="nothing was copied")
        stopped = "%s is disabled and %s.service stopped; nothing was copied" % (unit, net.daemon)

        # 3. The user's own processes, a plain GUI among them.
        with stage(stopped):
            end_user_processes(host, pw, args.terminate_sessions)

        # 4. Hold the source's lock for the rest of the command.
        with stage(stopped):
            lock_fd = take_lock(s_fd, s_display, pw.pw_uid)
        if lock_fd is not None:
            keep(lock_fd)

        # 5. Copy to fresh files, with the configuration files quarantined and sanitised first.
        with stage(stopped):
            t_fd, t_display = open_service_dir(paths, net, acct, create=True)
            keep(t_fd)
            if os.listdir(t_fd):
                raise UserError("%s exists and is not empty; refusing" % t_display)
            if os.geteuid() == 0 and os.fstat(t_fd).st_uid != acct.pw_uid:
                os.fchown(t_fd, acct.pw_uid, acct.pw_gid)
                os.fchmod(t_fd, 0o700)
            q_fd, q_display = open_quarantine(state_fd, paths, pw.pw_name, args.network, host)
            keep(q_fd)
            found, backups = quarantine_files(s_fd, s_display, pw.pw_uid, q_fd)
            settings_text, lines = sanitize_quarantined(found, patterns, q_fd, s_display)
            copy_tree(s_fd, t_fd, pw.pw_name, net.account, SKIP_TOP | QUARANTINE_TOP | testnet_entries, host,
                      s_display)
        with stage("the wallet is copied to %s, without its settings, and the source is untouched in %s; empty "
                   "%s before rerunning" % (t_display, s_display, t_display)):
            if settings_text is not None:
                write_file_as(t_fd, SETTINGS_NAME, settings_text.encode("utf8"), acct, host)
        report_quarantine(found, backups, q_display, lines)

        # 6. Stash the source where only root can reach it, so no second core can stake it.
        stash_name = s_name + STASH_INFIX + stamp(host)
        stash_display = os.path.join(os.path.dirname(s_display), stash_name)
        keep_in_source = testnet_entries | ({CONF_NAME} if shared_conf else set())
        with stage("the wallet is copied to %s; the source may be split between %s and %s, so move the stash's "
                   "entries back, or finish the move, before going on" % (t_display, s_display, stash_display)):
            stash_source(s_parent_fd, s_name, s_fd, stash_name, keep_in_source, stash_display,
                         copies={CONF_NAME: found[CONF_NAME]} if shared_conf else None)
        if shared_conf:
            print("%s stays in %s, as testnet reads it too; copies are in the stash and the quarantine."
                  % (CONF_NAME, d_display))
        moved = "the wallet is in %s and the source in %s" % (t_display, stash_display)
        with stage("%s; no owner record was written, so disable refuses until %s holds one"
                   % (moved, owner_record_path(paths, args.network))):
            write_owner_record(state_fd, args.network, pw, stash_display)

        # 7. The user attaches through the group; the service runs the wallet now.
        with stage("%s; %s is not in %s and the service is not enabled" % (moved, pw.pw_name, net.attach_group)):
            host.add_to_group(pw.pw_name, net.attach_group)
        step(host, "enable", "--now", net.daemon + ".service",
             state="%s; enable the service once the cause is fixed" % moved)

    # 8. What root and the user do next.
    print("%s's wallet is in %s now, run by %s.service as %s." % (pw.pw_name, t_display, net.daemon, net.account))
    print("The original datadir is kept in %s (root only); remove it once the service wallet is verified."
          % stash_display)
    print("%s must log out and back in for membership of %s to take effect." % (pw.pw_name, net.attach_group))
    return 0


def restore_conf(stash_path, parent_fd, parent_display, prefix, s_fd, pw, host):
    """Copy the user's own gridcoinresearch.conf back from the stash enable recorded, a root-only
    directory next to the datadir. Returns whether there was one to restore."""
    name = os.path.basename(stash_path)
    if parent_fd is None or os.path.dirname(stash_path) != parent_display or not name.startswith(prefix):
        raise UserError("the recorded stash %s is not where enable puts it" % shown(stash_path))
    stash_fd = open_dir(name, dir_fd=parent_fd, uids=(os.geteuid(),), display=stash_path)
    try:
        if os.fstat(stash_fd).st_mode & 0o077:
            raise UserError("%s is not root-only" % stash_path)
        if CONF_NAME not in os.listdir(stash_fd):
            return False
        data = read_owned_file(stash_fd, CONF_NAME, (pw.pw_uid,), os.path.join(stash_path, CONF_NAME))
    finally:
        os.close(stash_fd)
    write_file_as(s_fd, CONF_NAME, data, pw, host)
    return True


def cmd_disable(args, net, host, paths):
    pw = validate_user(args.user, host, paths)
    refuse_own_login(host, pw)
    acct = service_account(net, host, paths)
    patterns = load_refused_patterns(net.refused_keys)
    with contextlib.ExitStack() as stack:
        def keep(fd):
            stack.callback(os.close, fd)
            return fd

        # Only the user enable moved in takes the wallet out.
        state_fd = keep(open_tool_state(paths))
        record = read_owner_record(state_fd, paths, args.network)
        record_display = owner_record_path(paths, args.network)
        if record is None:
            raise UserError("%s is missing, so no %s wallet is recorded as moved into the service; refusing"
                            % (record_display, args.network))
        if record["uid"] != pw.pw_uid or record["user"] != pw.pw_name:
            raise UserError("%s records the wallet in the service as %s's (uid %d), not %s's; refusing"
                            % (record_display, shown(record["user"]), record["uid"], pw.pw_name))

        # The user's side must be free: a datadir made meanwhile, by a plain GUI say, may hold
        # coins of its own. The mainnet datadir may hold testnet's.
        home_fd = keep(open_home(pw))
        d_display = os.path.join(pw.pw_dir, DATADIR_NAME)
        s_display = os.path.join(d_display, "testnet") if net.testnet else d_display
        try:
            d_fd = keep(open_dir(DATADIR_NAME, dir_fd=home_fd, uids=(pw.pw_uid,), display=d_display))
        except FileNotFoundError:
            d_fd = None
        names = os.listdir(d_fd) if d_fd is not None else []
        if net.testnet and "testnet" in names:
            raise UserError("%s exists; move it aside first, then rerun" % s_display)
        if not net.testnet and any(not is_testnet_entry(n) and n != CONF_NAME for n in names):
            raise UserError("%s exists and holds more than testnet's datadir and the conf; move it aside first, "
                            "then rerun" % d_display)
        # A mainnet conf left beside testnet's datadir by enable is the user's own and stays.
        conf_kept = not net.testnet and CONF_NAME in names
        try:
            t_fd, t_display = open_service_dir(paths, net, acct, create=False)
        except FileNotFoundError:
            raise UserError("there is no service datadir at %s" % service_dir_display(paths, net)) from None
        keep(t_fd)
        refuse_other_network_core(host, args.network, pw.pw_name)

        end_user_processes(host, pw, args.terminate_sessions)
        system_unit, system_socket, _ = autounlock_target(net, None)
        step(host, "disable", "--now", system_unit, system_socket, state="nothing was copied")
        stopped = "%s.service and %s are disabled; nothing was copied" % (net.daemon, system_socket)
        with stage(stopped):
            lock_fd = take_lock(t_fd, t_display, acct.pw_uid)
        if lock_fd is not None:
            keep(lock_fd)

        # The quarantine comes first, and the directories made for the user go again if anything
        # up to the copy fails, so a rerun finds the user's side as it was.
        with stage(stopped):
            q_fd, q_display = open_quarantine(state_fd, paths, pw.pw_name, args.network, host)
            keep(q_fd)
            made = []
            try:
                if d_fd is None:
                    d_fd = keep(create_dir(DATADIR_NAME, home_fd, d_display, owner=pw))
                    made.append((home_fd, DATADIR_NAME))
                if net.testnet:
                    s_fd = keep(create_dir("testnet", d_fd, s_display, owner=pw))
                    made.append((d_fd, "testnet"))
                else:
                    s_fd = d_fd
                testnet_entries = set() if net.testnet else {"testnet"}
                found, backups = quarantine_files(t_fd, t_display, acct.pw_uid, q_fd)
                settings_text, lines = sanitize_quarantined(found, patterns, q_fd, t_display)
                copy_tree(t_fd, s_fd, net.account, pw.pw_name, SKIP_TOP | QUARANTINE_TOP | testnet_entries, host,
                          t_display)
            except BaseException:
                for parent_fd, name in reversed(made):
                    try:
                        os.rmdir(name, dir_fd=parent_fd)
                    except OSError:
                        pass
                raise
        copied = ("the wallet is copied to %s, %s still holds it, and %s.service stays disabled"
                  % (s_display, t_display, net.daemon))
        with stage("%s; the settings were not written" % copied):
            if settings_text is not None:
                write_file_as(s_fd, SETTINGS_NAME, settings_text.encode("utf8"), pw, host)
        report_quarantine(found, backups, q_display, lines)

        # The user's own conf comes back from the stash enable recorded; a failure here leaves
        # the wallet where it now is and says so.
        if net.testnet:
            stash_parent_fd, prefix = d_fd, "testnet" + STASH_INFIX
        else:
            stash_parent_fd, prefix = home_fd, DATADIR_NAME + STASH_INFIX
        stash_display = record["stash"]
        if conf_kept:
            restored = False
            print("Kept the %s already in %s, which testnet reads too; the stash's copy was not restored."
                  % (CONF_NAME, d_display))
        else:
            try:
                restored = restore_conf(stash_display, stash_parent_fd, os.path.dirname(s_display), prefix, s_fd,
                                        pw, host)
            except (UserError, TreeError, CopyError, OSError) as e:
                print("warning: %s was not restored: %s" % (CONF_NAME, e))
                restored = False

        # Empty the service datadir as its own account.
        with stage("%s; empty %s as %s before enabling again" % (copied, t_display, net.account)):
            run_as(host, acct, lambda: empty_dir(t_fd, testnet_entries), (t_fd,))
        moved = "the wallet is in %s and %s is empty" % (s_display, t_display)
        with stage("%s; %s is still in %s" % (moved, pw.pw_name, net.attach_group)):
            host.remove_from_group(pw.pw_name, net.attach_group)
        with stage("%s; remove %s by hand" % (moved, record_display)):
            os.unlink(args.network + ".owner", dir_fd=state_fd)

    print("%s's wallet is back in %s; %s.service is disabled." % (pw.pw_name, s_display, net.daemon))
    if restored:
        print("%s's own %s was restored from %s." % (pw.pw_name, CONF_NAME, stash_display))
    print("%s can be removed once the wallet is verified." % shown(stash_display))
    print("For a core under %s's own account: %s enable-user %s" % (pw.pw_name, net.tool_name, pw.pw_name))
    return 0


def build_parser(default_network):
    parser = argparse.ArgumentParser(prog=NETWORKS[default_network].tool_name)
    sub = parser.add_subparsers(dest="command", required=True)

    def add_network(p):
        p.add_argument("--network", choices=sorted(NETWORKS), default=default_network)

    p = sub.add_parser("enable-user")
    p.add_argument("user")
    p.add_argument("--datadir")
    add_network(p)
    p = sub.add_parser("disable-user")
    p.add_argument("user")
    add_network(p)
    p = sub.add_parser("autounlock")
    p.add_argument("action", choices=("enable", "disable"))
    p.add_argument("user", nargs="?")
    p.add_argument("--system", action="store_true")
    add_network(p)
    for command in ("enable", "disable"):
        p = sub.add_parser(command)
        p.add_argument("user")
        p.add_argument("--terminate-sessions", action="store_true",
                       help="end the user's sessions (loginctl terminate-user) instead of refusing")
        add_network(p)
    return parser


def main(argv, host=None, paths=None):
    if any(v.startswith("@") for v in CONFIG.values()):
        print("gridcoin-service: not configured (build-time values missing)", file=sys.stderr)
        return EXIT_USAGE
    host = host if host is not None else Host()
    paths = paths if paths is not None else Paths()
    pre = argparse.ArgumentParser(add_help=False)
    pre.add_argument("--network", choices=sorted(NETWORKS), default=CONFIG["default_network"])
    known, _ = pre.parse_known_args(argv)
    parser = build_parser(known.network)
    args = parser.parse_args(argv)
    if args.command == "autounlock" and (args.system == (args.user is not None)):
        parser.error("autounlock needs exactly one of <user> or --system")
    if not host.is_root():
        print("gridcoin-service: must be run as root", file=sys.stderr)
        return 1
    net = NETWORKS[args.network]
    handlers = {"enable-user": cmd_enable_user, "disable-user": cmd_disable_user, "autounlock": cmd_autounlock,
                "enable": cmd_enable, "disable": cmd_disable}
    try:
        return handlers[args.command](args, net, host, paths)
    except (UserError, StepError, TreeError, CopyError, OSError) as e:
        print("%s: %s" % (net.tool_name, e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
