# Suppressions should use `sanitize-type:ClassName::MethodName`.

# -fsanitize=undefined suppressions
# =================================

# -fsanitize=integer suppressions
# ===============================
# The integer checks report behaviour that is defined (unsigned wrap-around, an
# implicit conversion that changes a value), so each entry below is a place
# that means it. Anything else the CI sanitizer job reports is a finding.
#
# Dependencies
# ------------
# Suppressions in dependencies that are developed outside this repository.
unsigned-integer-overflow:*/include/c++/
unsigned-integer-overflow:leveldb/
unsigned-integer-overflow:secp256k1/
implicit-integer-sign-change:*/include/boost/
implicit-integer-sign-change:*/include/c++/
implicit-integer-sign-change:*/new_allocator.h
implicit-integer-sign-change:*/qarraydata.h
implicit-integer-sign-change:*/qflags.h
implicit-integer-sign-change:crc32c/
implicit-integer-sign-change:BytewiseComparatorImpl::FindShortSuccessor
implicit-integer-sign-change:secp256k1/
implicit-signed-integer-truncation:*/include/c++/
implicit-signed-integer-truncation:leveldb/
implicit-signed-integer-truncation:secp256k1/
implicit-signed-integer-truncation,implicit-integer-sign-change:secp256k1_modinv64_posdivsteps_62_var
implicit-unsigned-integer-truncation:*/include/c++/
implicit-unsigned-integer-truncation:leveldb/
implicit-unsigned-integer-truncation:secp256k1/
shift-base:*/include/c++/
shift-base:leveldb/
shift-base:secp256k1/

# Suppressions in code developed inside this repository.
# ------------
# Hash and cipher arithmetic, which wraps by design.
unsigned-integer-overflow:arith_uint256.h
unsigned-integer-overflow:crypto/
unsigned-integer-overflow:gridcoin/md5.c
unsigned-integer-overflow:hash.cpp
unsigned-integer-overflow:scrypt.cpp
implicit-integer-sign-change:crypto/
implicit-integer-sign-change:gridcoin/md5.c
implicit-signed-integer-truncation:crypto/
implicit-signed-integer-truncation:gridcoin/md5.c
implicit-unsigned-integer-truncation:crypto/
implicit-unsigned-integer-truncation:gridcoin/md5.c
shift-base:arith_uint256.cpp
shift-base:crypto/
shift-base:gridcoin/md5.c
shift-base:hash.cpp
shift-base:scrypt.cpp
shift-base:streams.h
shift-base:util/bip32.cpp
#
# SeenStakes::GetOffset is a multiply-shift hash over the proof hash's words.
unsigned-integer-overflow:GRC::SeenStakes::GetOffset
#
# WithinTimeDrift subtracts as uint64_t on purpose: for a >= b,
# uint64_t(a) - uint64_t(b) is exactly a - b even when it wraps, which is what
# keeps the drift of two extreme int64_t times from overflowing.
unsigned-integer-overflow:WithinTimeDrift
#
# EvalScript's stacktop(i) adds a negative int to stack.size(). Bitcoin Core
# casts through int64_t in the macro instead; that change is in consensus code
# and is not made here, so the wrap is suppressed for EvalScript alone.
unsigned-integer-overflow:EvalScript
implicit-integer-sign-change:EvalScript
