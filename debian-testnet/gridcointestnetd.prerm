#!/bin/sh
set -e

case "$1" in
    remove)
        # dh_installsystemd stops the system units. The per-user cores and the helper
        # sockets and services are stopped here; the units this build left out are
        # not there to stop.
        if [ -d /run/systemd/system ]; then
            systemctl stop 'gridcointestnetd@*.service' 'gridcointestnet-autounlock@*.socket' \
                'gridcointestnet-autounlock@*.service' gridcointestnet-autounlock.socket >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
