#!/bin/sh
set -e

# Before this release the system service gridcointestnetd.service was a forking daemon
# (and, on hosts with a test build, so was the per-user gridcointestnetd@<user>.service,
# with the RPC helper unit gridcointestnetd-autounlock@<user>.service). On an upgrade from
# such a version, record what was enabled, running or overridden, for the postinst to
# hand to "gridcointestnet-service switch-over", and turn the old autounlock units off
# while their unit files still exist. The cores keep running. The postrm turns the old
# units back on if the upgrade is aborted.

DAEMON=gridcointestnetd
OLD_AUTOUNLOCK=gridcointestnetd-autounlock
UNIT_DIR=/etc/systemd/system
STATE_DIR=/var/lib/gridcoin-service
STATE=$STATE_DIR/switchover-test.state
# What this run recorded, and the state file as it was before, for an aborted upgrade.
RECORDED=$STATE_DIR/switchover-test.recorded
BEFORE=$STATE_DIR/switchover-test.before
# The first version of this package with the notify units and gridcointestnet-service. Set
# it at the release cut, together with the postinst's and the version in
# gridcointestnetd.NEWS.
FIRST_NEW_VERSION=5.5.2.1~

# The user in a <prefix>@<user>.service unit name or path ($1, prefix $2), if any.
instance_user() {
    name=${1##*/}
    case $name in
        "$2"@?*.service)
            user=${name#"$2"@}
            printf '%s\n' "${user%.service}"
            ;;
    esac
}

record_state() {
    mkdir -p "$STATE_DIR"
    chown root:root "$STATE_DIR"
    chmod 0700 "$STATE_DIR"
    active=
    if [ -d /run/systemd/system ]; then
        active=$(systemctl list-units --state=active --plain --no-legend "$DAEMON@*.service")
    fi
    new=$STATE.new
    rm -f "$new"
    (
        umask 077
        {
            for link in "$UNIT_DIR"/*.wants/"$OLD_AUTOUNLOCK"@*.service; do
                if [ -L "$link" ]; then
                    user=$(instance_user "$link" "$OLD_AUTOUNLOCK")
                    if [ -n "$user" ]; then
                        printf '%s\n' "autounlock $user"
                    fi
                fi
            done
            for link in "$UNIT_DIR"/*.wants/"$DAEMON"@*.service; do
                if [ -L "$link" ]; then
                    user=$(instance_user "$link" "$DAEMON")
                    if [ -n "$user" ]; then
                        printf '%s\n' "core $user"
                    fi
                fi
            done
            printf '%s\n' "$active" | while read -r unit _; do
                user=$(instance_user "$unit" "$DAEMON")
                if [ -n "$user" ]; then
                    printf '%s\n' "core-active $user"
                fi
            done
            # A copy of the system unit, or a drop-in for it (User=gridcoin, say): either
            # may have been written for the forking daemon, and the switch-over decides.
            overridden=
            if [ -e "$UNIT_DIR/$DAEMON.service" ] || [ -L "$UNIT_DIR/$DAEMON.service" ]; then
                overridden=1
            fi
            for dropin in "$UNIT_DIR/$DAEMON.service.d"/*.conf; do
                if [ -e "$dropin" ] || [ -L "$dropin" ]; then
                    overridden=1
                fi
            done
            if [ -n "$overridden" ]; then
                printf '%s\n' "system-core"
            fi
        } > "$new"
    )
    if [ ! -s "$new" ]; then
        rm -f "$new"
        return 0
    fi
    cp "$new" "$RECORDED"
    if [ -e "$STATE" ]; then
        # A switch-over that has not finished yet keeps its entries.
        cp -p "$STATE" "$BEFORE"
        cat "$new" >> "$STATE"
        rm -f "$new"
    else
        mv "$new" "$STATE"
    fi
}

stop_old_autounlock() {
    for link in "$UNIT_DIR"/*.wants/"$OLD_AUTOUNLOCK"@*.service; do
        if [ -L "$link" ]; then
            # A link whose unit file is gone (the package was removed, not purged) is
            # removed by hand.
            systemctl disable "${link##*/}" >/dev/null 2>&1 || rm -f "$link"
        fi
    done
    if [ -d /run/systemd/system ]; then
        systemctl stop "$OLD_AUTOUNLOCK@*.service" >/dev/null 2>&1 || true
    fi
}

case "$1" in
    install|upgrade)
        if [ -n "$2" ] && dpkg --compare-versions "$2" lt "$FIRST_NEW_VERSION"; then
            record_state
            stop_old_autounlock
        fi
        ;;
esac

#DEBHELPER#

exit 0
