#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

# Parallelism is left to the builder (dpkg-buildpackage -j / DEB_BUILD_OPTIONS /
# OBS job limits) rather than hardcoded, so each build host uses its own capacity.

# ARM SHA-NI intrinsics compiled for armhf (AArch32) produce incorrect SHA256
# results when the build host is aarch64. The cmake detection check only tests
# whether -march=armv8-a+crc+crypto compiles, not whether it runs correctly.
ifeq ($(DEB_HOST_ARCH),armhf)
CMAKE_ARCH_FLAGS = -DENABLE_ARM_SHANI=OFF
endif

# arm64 (aarch64): disable x86-only SIMD feature probes that aarch64-linux-gnu-g++
# rejects (-msse4.1/-mavx2/-msha are not valid flags on this architecture).
#
# cmake 3.25's find_library() fails to locate multiarch libraries under
# /usr/lib/aarch64-linux-gnu/ when the dpkg hardening CFLAGS are present in the
# environment. CMAKE_LIBRARY_PATH was attempted but is unreliable in this
# combination. Explicitly pre-seeding the library cache variables bypasses
# find_library() entirely (FindCURL/FindOpenSSL/FindZLIB each guard their
# find_library() call with "if(NOT <VAR>)"). --fresh ensures no stale NOTFOUND
# values from a previous failed run survive into the new configure.
#
# --fresh requires cmake >= 3.24; jammy ships 3.22.1 and errors with "Unknown
# argument --fresh". Gate it on the build host's cmake version so jammy arm64
# still configures while newer distros (noble/trixie) keep --fresh.
CMAKE_VERSION := $(shell cmake --version | sed -n 's/^cmake version //p')
CMAKE_FRESH := $(shell dpkg --compare-versions "$(CMAKE_VERSION)" ge 3.24 && echo --fresh)
ifeq ($(DEB_HOST_ARCH),arm64)
CMAKE_ARCH_FLAGS = \
	$(CMAKE_FRESH) \
	-DENABLE_SSE41=OFF \
	-DENABLE_AVX2=OFF \
	-DENABLE_X86_SHANI=OFF \
	-DOPENSSL_CRYPTO_LIBRARY=/usr/lib/$(DEB_HOST_MULTIARCH)/libcrypto.so \
	-DOPENSSL_SSL_LIBRARY=/usr/lib/$(DEB_HOST_MULTIARCH)/libssl.so \
	-DCURL_LIBRARY=/usr/lib/$(DEB_HOST_MULTIARCH)/libcurl.so \
	-DZLIB_LIBRARY=/usr/lib/$(DEB_HOST_MULTIARCH)/libz.so
endif

# The autounlock helper and its units need systemd 251 or later, so the build host's
# systemd (Build-Depends) decides whether they are built: Ubuntu 22.04 builds without
# them, and gridcoin-service then knows there are none.
SYSTEMD_MAJOR := $(shell systemctl --version 2>/dev/null | sed -n '1s/^systemd \([0-9]*\).*/\1/p')
AUTOUNLOCK := $(shell [ "$(SYSTEMD_MAJOR)" -ge 251 ] 2>/dev/null && echo ON || echo OFF)
UNITDIR := debian/tmp/usr/lib/systemd/system

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DENABLE_DAEMON=ON \
		-DENABLE_GUI=ON \
		-DUSE_QT6=ON \
		-DENABLE_TESTS=ON \
		-DENABLE_QRENCODE=ON \
		-DENABLE_UPNP=ON \
		-DENABLE_MULTIPROCESS=ON \
		-DUSE_DBUS=ON \
		-DENABLE_PIE=ON \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DGRC_UNIT_NETWORK=main \
		-DINSTALL_SYSTEMD_AUTOUNLOCK=$(AUTOUNLOCK) \
		$(CMAKE_ARCH_FLAGS)

ifeq ($(DEB_HOST_ARCH),armhf)
override_dh_auto_test:
	: # Tests skipped on armhf: sha256::TransformD64 (scalar, fully unrolled) produces
	: # wrong results when cross-compiled for armhf on an aarch64 Launchpad builder.
	: # Root cause: GCC 11 register-allocation bug in very large unrolled functions
	: # under -O2 on the aarch64-to-armhf cross toolchain. The binary is correct on
	: # native armhf hardware; this is a builder-environment false-positive.
else
override_dh_auto_test:
	dh_auto_test -- ARGS="--output-on-failure"
endif

# With autounlock, the helper and its per-user template units go in as files, like the
# core's template in gridcoinresearchd.install: dh_installsystemd skips template units.
# dh_install takes the last of several command-line paths as the destination
# directory, so each call names its own.
execute_after_dh_install:
ifeq ($(AUTOUNLOCK),ON)
	dh_install -pgridcoinresearchd \
		usr/lib/systemd/system/gridcoin-autounlock@.socket \
		usr/lib/systemd/system/gridcoin-autounlock@.service \
		usr/lib/systemd/system
	dh_install -pgridcoinresearchd \
		usr/libexec/gridcoin/gridcoin-autounlock-helper \
		usr/libexec/gridcoin
endif

# The system units are handed to dh_installsystemd as debian/gridcoinresearchd.<unit>
# (listed in debian/clean), so it installs them and writes their maintainer script
# snippets: not enabled or started on install, stopped on removal, and try-restarted
# after an upgrade so that a running service runs the new daemon and unit.
execute_before_dh_installsystemd:
	cp $(UNITDIR)/gridcoinresearchd.service debian/gridcoinresearchd.gridcoinresearchd.service
ifeq ($(AUTOUNLOCK),ON)
	cp $(UNITDIR)/gridcoin-autounlock.socket debian/gridcoinresearchd.gridcoin-autounlock.socket
	cp $(UNITDIR)/gridcoin-autounlock.service debian/gridcoinresearchd.gridcoin-autounlock.service
endif

override_dh_installsystemd:
	dh_installsystemd -pgridcoinresearchd --name=gridcoinresearchd --no-enable --no-start --restart-after-upgrade
ifeq ($(AUTOUNLOCK),ON)
	dh_installsystemd -pgridcoinresearchd --name=gridcoin-autounlock --no-enable --no-start --restart-after-upgrade
endif

# The daemon is execute-only (0711), as CMake installs it; dh_fixperms makes it 0755.
execute_after_dh_fixperms:
	chmod 0711 debian/gridcoinresearchd/usr/bin/gridcoinresearchd

# No automatic -dbgsym packages: they clutter the user-facing repo and almost
# nobody runs gdb against these; insiders rebuild locally with symbols when needed.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
