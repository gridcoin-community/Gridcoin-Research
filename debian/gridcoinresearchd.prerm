#!/bin/sh
set -e

case "$1" in
    remove)
        # The system service, the per-user cores and the helper sockets and services are
        # stopped here. dh_installsystemd writes no stop for a unit it is told not to
        # start (--no-start in debian/rules). The plainly named units go through
        # deb-systemd-invoke, which asks policy-rc.d first, as debhelper's own stop
        # does. It hands each name to a shell unquoted, so the patterns stay with
        # systemctl. The units this build left out are not there to stop.
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop gridcoinresearchd.service gridcoin-autounlock.socket \
                gridcoin-autounlock.service >/dev/null 2>&1 || true
            systemctl stop 'gridcoinresearchd@*.service' 'gridcoin-autounlock@*.socket' \
                'gridcoin-autounlock@*.service' >/dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
